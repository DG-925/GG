<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:GG.App.ViewModels">
    <!-- Dependencies merged explicitly so StaticResource lookups never depend on load order. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        One cover card in the grid. Size is set by AdaptiveGridPanel (2:3 aspect).
        Layers, bottom to top: fallback (gradient + icon + name), cover image, badges, hover overlay, outline.
    -->
    <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameViewModel}">
        <Grid x:Name="Root" Background="Transparent" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PlayCommand}" />
            </Grid.InputBindings>

            <!-- Fallback when there is no cover: dark card tinted by launcher, icon and name. -->
            <Border CornerRadius="{StaticResource CardCorner}"
                    Background="{Binding Source, Converter={StaticResource SourceToGradient}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="14">
                        <Image Source="{Binding IconImage}" Width="56" Height="56" Margin="0,0,0,14"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IconImage, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                                   Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                </Grid>
            </Border>

            <!-- Cover art (ImageBrush so the rounded corners clip it). -->
            <Border CornerRadius="{StaticResource CardCorner}"
                    Visibility="{Binding CoverImage, Converter={StaticResource NullToCollapsed}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <!-- Always-visible badges. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                <Border CornerRadius="11" Background="#99000000" Padding="5" Margin="0,0,4,0"
                        Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource FavoriteBrush}" />
                </Border>
                <Border CornerRadius="4" Background="{StaticResource WarningBrush}" Padding="6,2"
                        Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="GG wasn't sure which .exe starts this game">
                    <TextBlock Text="Needs review" FontSize="10" FontWeight="SemiBold" Foreground="#1A1200" />
                </Border>
            </StackPanel>

            <!-- Hover overlay: darkening gradient, play button, favorite toggle, name and playtime. -->
            <Border x:Name="Overlay" CornerRadius="{StaticResource CardCorner}" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#33000000" />
                        <GradientStop Offset="0.45" Color="#55000000" />
                        <GradientStop Offset="1" Color="#EE000000" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Play" />

                    <Button Content="{Binding FavoriteGlyph}" Command="{Binding ToggleFavoriteCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            ToolTip="Favorite">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CardIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource FavoriteBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PlaytimeText}" Foreground="#B3FFFFFF" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="Outline" CornerRadius="{StaticResource CardCorner}" BorderThickness="2"
                    BorderBrush="{StaticResource AccentBrush}" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <DataTemplate.Triggers>
            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity"
                                             To="0.9" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.03" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.03" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Outline" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
