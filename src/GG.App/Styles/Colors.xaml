<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark palette used everywhere. -->
    <Color x:Key="WindowColor">#0E1014</Color>
    <Color x:Key="SidebarColor">#13161B</Color>
    <Color x:Key="SurfaceColor">#1A1E25</Color>
    <Color x:Key="SurfaceHoverColor">#232831</Color>
    <Color x:Key="CardColor">#1E232B</Color>
    <Color x:Key="BorderColor">#2A303A</Color>
    <Color x:Key="AccentColor">#7C5CFF</Color>
    <Color x:Key="AccentHoverColor">#937AFF</Color>
    <Color x:Key="TextPrimaryColor">#ECEEF2</Color>
    <Color x:Key="TextSecondaryColor">#9BA3AF</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="FavoriteColor">#FFC83D</Color>
    <Color x:Key="WarningColor">#FF9F43</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="FavoriteBrush" Color="{StaticResource FavoriteColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Icon font: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Inter is embedded in GG.exe (Fonts/); Segoe UI is only a fallback. "Inter Display" is the tighter cut for big titles. -->
    <FontFamily x:Key="UiFont">/GG;component/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">/GG;component/Fonts/#Inter Display, Segoe UI</FontFamily>

    <sys:Double x:Key="CornerSize">10</sys:Double>
    <CornerRadius x:Key="CardCorner">10</CornerRadius>
    <CornerRadius x:Key="ControlCorner">6</CornerRadius>
</ResourceDictionary>
