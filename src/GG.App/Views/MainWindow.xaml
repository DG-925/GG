<Window x:Class="GG.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GG.App.Controls"
        Title="GG" Width="1280" Height="820" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,18,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="GG" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GG" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="17" />
                        <TextBlock Text="All your games" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Filters + launchers -->
                <ListBox Grid.Row="1" ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Normal entry -->
                                <Grid Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" />
                                </Grid>
                                <!-- Section header -->
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left"
                            Command="{Binding OpenDataFolderCommand}" ToolTip="Open %AppData%\GG (library.json, settings.json, logs)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Open data folder" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Main area ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Margin="28,18,28,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search games  (Ctrl+F)"
                         MaxWidth="440" HorizontalAlignment="Stretch"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Sort" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="150" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center"
                            ToolTip="Card size">
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Slider Width="110" Margin="10,0" Minimum="120" Maximum="300" Value="{Binding CardWidth, Mode=TwoWay}"
                            SmallChange="10" LargeChange="30" />
                    <TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Margin="20,0,0,0" Height="36"
                        Command="{Binding ScanCommand}" ToolTip="Scan for games (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="Scan" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Section title + count -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,14,28,10">
                <TextBlock Text="{Binding HeaderTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,5">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" games" />
                </TextBlock>
            </StackPanel>

            <!-- Game grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,8,20,28" Focusable="False">
                <ItemsControl ItemsSource="{Binding GamesView}" ItemTemplate="{StaticResource GameCardTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveGridPanel ItemWidth="{Binding CardWidth}" AspectRatio="1.5" Spacing="18" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding VisibleCount, Converter={StaticResource ZeroToVisible}}">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="48"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No games here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                <TextBlock Text="Try another filter, clear the search, or press Scan." Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Status bar -->
            <Border Grid.Row="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="28,7"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
