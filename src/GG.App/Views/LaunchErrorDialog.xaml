<Window x:Class="GG.App.Views.LaunchErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GG" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="40" Height="40" CornerRadius="20" Background="#33FF9F43" VerticalAlignment="Top">
            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="18" FontWeight="Normal"
                       Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <TextBlock x:Name="TitleText" Grid.Column="1" Margin="14,0,0,0" FontFamily="{StaticResource DisplayFont}"
                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />

        <TextBlock x:Name="MessageText" Grid.Row="1" Grid.Column="1" Margin="14,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="LocateButton" Style="{StaticResource PrimaryButton}" Content="Locate exe..." Click="OnLocate" IsDefault="True" />
            <Button Content="Close" Margin="10,0,0,0" Click="OnClose" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
